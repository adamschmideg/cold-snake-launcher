<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/ground"
    android:padding="32dp">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/phosphor"
        android:textSize="28sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginBottom="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/session_prompt"
        android:textColor="@color/steel"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp">

        <Button
            android:id="@+id/duration2s"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textSize="12sp"
            android:text="@string/duration_2s"
            android:fontFamily="monospace"
            android:textColor="@color/cold_white"
            android:backgroundTint="@color/teal" />

        <Button
            android:id="@+id/duration10s"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textSize="12sp"
            android:text="@string/duration_10s"
            android:fontFamily="monospace"
            android:textColor="@color/cold_white"
            android:backgroundTint="@color/teal" />

        <Button
            android:id="@+id/duration1m"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textSize="12sp"
            android:text="@string/duration_1m"
            android:fontFamily="monospace"
            android:textColor="@color/cold_white"
            android:backgroundTint="@color/teal" />

    </LinearLayout>

    <Button
        android:id="@+id/startSession"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_session"
        android:fontFamily="monospace"
        android:textColor="@color/ground"
        android:backgroundTint="@color/warning_pop"
        android:paddingLeft="24dp"
        android:paddingRight="24dp" />

    <TextView
        android:id="@+id/cooldownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/steel"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:visibility="gone" />

</LinearLayout>
